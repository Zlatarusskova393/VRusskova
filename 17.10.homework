using System;

class Program
{
    static void Main(string[] args)
    {
        Task1();
        // Task2();
        // Task3();
        // Task4();
        // Task5();
        // Task6();
        // Task7();
        // Task8();
    }

    static void Task1()
    {
        float x = 2.5f, y = 3.0f, z = 1.5f;
        float dx = 1.5f, dy = -2.0f, dz = 0.5f;

        float nx = x + dx;
        float ny = y + dy;
        float nz = z + dz;

        Console.WriteLine($"New position: ({nx}, {ny}, {nz})");
    }

    static void Task2()
    {
        int distance = 1500;
        int time = 120;

        double speed = (double)distance / time;
        double timeFor2500 = 2500.0 / speed;

        Console.WriteLine($"Speed: {speed} m/s");
        Console.WriteLine($"Time for 2500 m: {timeFor2500} s");
    }

    static void Task3()
    {
        double celsius = 25.0;

        double fahrenheit = celsius * 9.0 / 5.0 + 32.0;

        Console.WriteLine($"{celsius} C = {fahrenheit} F");
    }

    static void Task4()
    {
        string modelName = "Dragon";
        int polygons = 15000;
        float animDuration = 2.5f;
        bool isVisible = true;
        float rotationAngle = 45.0f;

        Console.WriteLine($"Model: {modelName}");
        Console.WriteLine($"Polygons: {polygons}");
        Console.WriteLine($"Animation duration: {animDuration} s");
        Console.WriteLine($"Visible: {isVisible}");
        Console.WriteLine($"Rotation angle: {rotationAngle} degrees");
    }

    static void Task5()
    {
        double value = 7.85;

        int intValue = (int)value;
        double backToDouble = intValue;

        Console.WriteLine($"Original: {value}");
        Console.WriteLine($"To int: {intValue}");
        Console.WriteLine($"Back to double: {backToDouble}");
        Console.WriteLine($"Are they equal? {value == backToDouble}");
    }

    static void Task6()
    {
        string data = "x=10;y=20;z=30";
        string[] parts = data.Split(';');

        foreach (string part in parts)
        {
            string[] pair = part.Split('=');
            Console.WriteLine($"Coordinate {pair[0]} = {pair[1]}");
        }
    }

    static void Task7()
    {
        string fileName = "level_01_scene.unity";

        int dotIndex = fileName.IndexOf('.');
        string nameOnly = fileName.Substring(0, dotIndex);
        string upperName = nameOnly.ToUpper();

        Console.WriteLine(upperName);
    }

    static void Task8()
    {
        Console.Write("Enter your name: ");
        string name = Console.ReadLine();

        Console.Write("Enter your birth year: ");
        int birthYear = int.Parse(Console.ReadLine());

        int currentYear = 2026;
        int age = currentYear - birthYear;

        Console.WriteLine($"Hello, {name}! You are {age} years old.");
        Console.WriteLine($"Your name in uppercase: {name.ToUpper()}");
        Console.WriteLine($"Name length: {name.Length} characters");
    }
}
